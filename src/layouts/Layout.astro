---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  preloadImage?: string;
}

const {
  title,
  description = "Professeur de clarinette et de formation musicale — cours en présentiel et à distance, à Bruxelles, en Belgique et en France.",
  image = "/og-arthur.jpg",
  imageAlt,
  type = "website",
  preloadImage,
} = Astro.props;

const pathname = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const canonicalUrl = `${siteUrl}${pathname}`;
const ogImageUrl = `${siteUrl}${image}`;
const ogImageAlt = imageAlt ?? `${title} — Arthur Reynaud-Chanon`;

const pathToLabel: Record<string, string> = {
  '/presentation': 'Présentation',
  '/enseignement': 'Enseignement',
  '/enseignement/clarinette': 'Cours de clarinette',
  '/enseignement/saxophone': 'Cours de saxophone',
  '/enseignement/formation-musicale': 'Cours de formation musicale',
  '/enseignement/piano': 'Initiation au piano',
  '/enseignement/chant': 'Initiation au chant',
  '/enseignement/respiration': 'Respiration et relaxation',
  '/evenements': 'Événements & Booking',
  '/complements': 'Avis & Vidéos',
  '/contact': 'Contact',
  '/mentions-legales': 'Mentions légales',
};

const breadcrumbItems: Array<{ '@type': string; position: number; name: string; item: string }> = [];
if (pathname !== '/') {
  breadcrumbItems.push({ '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` });
  let currentPath = '';
  pathname.split('/').filter(Boolean).forEach((part, i) => {
    currentPath += '/' + part;
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: i + 2,
      name: pathToLabel[currentPath] ?? part,
      item: `${siteUrl}${currentPath}`,
    });
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#arthur`,
      "name": "Arthur Reynaud-Chanon",
      "jobTitle": "Professeur de clarinette et de formation musicale",
      "url": siteUrl,
      "email": "arthur.reynaudchanon@gmail.com",
      "telephone": ["+33633184584", "+32473447186"],
      "address": { "@type": "PostalAddress", "addressLocality": "Bruxelles", "addressCountry": "BE" },
      "knowsLanguage": ["fr", "en", "pl", "es"],
      "knowsAbout": ["clarinette", "saxophone", "formation musicale", "piano", "chant"],
      "image": ogImageUrl,
      "description": "Professeur de clarinette, saxophone et formation musicale, clarinettiste soliste et chambriste. Cours en présentiel à Bruxelles, en Belgique et en France, et à distance dans le monde entier.",
      "sameAs": [
        "https://www.facebook.com/share/18w51J1m97",
        "https://www.instagram.com/arthur.rc.clarinetttiste",
        "https://www.apprentus.be/cours-particuliers/bruxelles/musique/clarinette/apprendre-clarinette-solfege-a-domicile?from_landing_page=true",
        "https://www.superprof.be/clarinettiste-professeur-clarinette-formation-musicale-diplome-deux-domaines-donne-cours-clarinette.html"
      ]
    },
    {
      "@type": ["LocalBusiness", "EducationalOrganization"],
      "@id": `${siteUrl}/#business`,
      "name": "Arthur Reynaud-Chanon — Cours de musique",
      "url": siteUrl,
      "email": "arthur.reynaudchanon@gmail.com",
      "telephone": "+32473447186",
      "address": { "@type": "PostalAddress", "addressLocality": "Bruxelles", "addressCountry": "BE" },
      "areaServed": [{ "@type": "Country", "name": "Belgique" }, { "@type": "Country", "name": "France" }],
      "priceRange": "€€",
      "founder": { "@id": `${siteUrl}/#arthur` },
      "image": ogImageUrl,
      "description": "Cours particuliers de clarinette, saxophone, formation musicale, piano, chant et respiration à Bruxelles et à distance. Prestations événementielles en Belgique et en France.",
      "sameAs": ["https://www.facebook.com/share/18w51J1m97", "https://www.instagram.com/arthur.rc.clarinetttiste"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Cours de musique",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cours de clarinette" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cours de saxophone" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cours de formation musicale" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Initiation au piano" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Initiation au chant" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cours de respiration" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Prestation clarinette solo" } }
        ]
      }
    },
    ...(breadcrumbItems.length > 1 ? [{ "@type": "BreadcrumbList", "itemListElement": breadcrumbItems }] : [])
  ]
};

interface NavChild { href: string; label: string; }
interface NavItem  { href?: string; label: string; children?: NavChild[]; }

const navLinks: NavItem[] = [
  { href: '/',             label: 'Accueil' },
  { href: '/presentation', label: 'Présentation' },
  {
    label: 'Enseignement',
    children: [
      { href: '/enseignement/clarinette',        label: 'Cours de clarinette' },
      { href: '/enseignement/saxophone',          label: 'Cours de saxophone' },
      { href: '/enseignement/formation-musicale', label: 'Cours de formation musicale' },
      { href: '/enseignement/respiration',        label: 'Respiration' },
      { href: '/enseignement/chant',              label: 'Initiation au chant' },
      { href: '/enseignement/piano',              label: 'Cours de piano' },
    ],
  },
  { href: '/evenements',  label: 'Événements' },
  { href: '/complements', label: 'Avis & Vidéos' },
  { href: '/contact',     label: 'Contact' },
];

function isActive(href: string | undefined) {
  if (!href) return false;
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Titre & description -->
  <title>{title} — Arthur Reynaud-Chanon</title>
  <meta name="description" content={description}>
  <meta name="author" content="Arthur Reynaud-Chanon">

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl}>

  <!-- Référencement local -->
  <meta name="geo.region" content="BE-BRU">
  <meta name="geo.placename" content="Bruxelles, Belgique">

  <!-- Open Graph (partage réseaux sociaux) -->
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content="Arthur Reynaud-Chanon">
  <meta property="og:title" content={`${title} — Arthur Reynaud-Chanon`}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:locale" content="fr_BE">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} — Arthur Reynaud-Chanon`}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <!-- JSON-LD : entités structurées (Person, LocalBusiness, fil d'Ariane) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Slot pour JSON-LD spécifique à chaque page (Service, Event…) -->
  <slot name="head" />

  <!-- Préchargement image hero (Core Web Vitals LCP) -->
  {preloadImage && <link rel="preload" as="image" href={preloadImage}>}

  <!-- Polices -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<header class="header" id="header">
  <div class="container">
    <a href="/" class="logo">Arthur <span>Reynaud-Chanon</span></a>
    <nav class="nav" id="nav">
      {navLinks.map(({ href, label, children }) => (
        children ? (
          <div class:list={['nav-item', 'has-dropdown', { active: isActive(href) }]}>
            {href
              ? <a href={href} class:list={[{ active: isActive(href) }]}>{label}</a>
              : <button class="nav-parent-btn" type="button">{label}</button>
            }
            <button class="dropdown-toggle" type="button" aria-label="Afficher le sous-menu">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="dropdown">
              {children.map(child => (
                <a href={child.href} class:list={[{ active: pathname === child.href }]}>{child.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={href} class:list={[{ active: isActive(href) }]}>{label}</a>
        )
      ))}
    </nav>
    <button class="burger" id="burger" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="brand">
        <h4 style="font-family:'Playfair Display',serif; font-size:1.3rem; margin-bottom:16px;">
          Arthur <span style="color:var(--gold); font-style:italic;">Reynaud-Chanon</span>
        </h4>
        <p>Professeur de clarinette et de formation musicale. Cours en présentiel et à distance. Français, English, Polski, Español.</p>
        <div class="social-links">
          <a href="https://www.facebook.com/share/18w51J1m97" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/arthur.rc.clarinetttiste?igsh=eGN0YzQ5N3ZzZmRx" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-nav">
        <h4>Navigation</h4>
        <ul class="footer-links">
          {navLinks.map(({ href, label }) => (
            <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>
          ))}
          <li><a href="/mentions-legales">Mentions légales</a></li>
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <div class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          <a href="tel:+33633184584" style="color:inherit; text-decoration:none;">+33 6 33 18 45 84</a>
        </div>
        <div class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          <a href="tel:+32473447186" style="color:inherit; text-decoration:none;">+32 473 44 71 86</a>
        </div>
        <div class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <a href="mailto:arthur.reynaudchanon@gmail.com" style="color:inherit; text-decoration:none;">arthur.reynaudchanon@gmail.com</a>
        </div>
        <div class="contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Bruxelles, Belgique</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
      <p style="margin:0;">
        &copy; 2026 Arthur Reynaud-Chanon. Tous droits réservés.
        <span style="margin:0 8px; opacity:0.4;">—</span>
        <a href="/mentions-legales" style="color:inherit; opacity:0.7; text-decoration:none; border-bottom:1px solid currentColor;">Mentions légales</a>
      </p>
      <p style="margin:0; opacity:0.6; font-size:0.82rem;">
        Site réalisé par <a href="https://air-tricks-prod.vercel.app/" target="_blank" rel="noopener" style="color:inherit; text-decoration:none; border-bottom:1px solid currentColor;">Air Trick Prod</a>
      </p>
    </div>
  </div>
</footer>

<script>
  const header = document.getElementById('header')!;
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 40);
  });

  const burger = document.getElementById('burger')!;
  const nav = document.getElementById('nav')!;

  burger.addEventListener('click', () => {
    burger.classList.toggle('active');
    nav.classList.toggle('open');
  });

  // Ferme le menu mobile sur clic d'un lien simple
  nav.querySelectorAll('a:not(.has-dropdown a)').forEach(link => {
    link.addEventListener('click', () => {
      burger.classList.remove('active');
      nav.classList.remove('open');
    });
  });

  // Toggle sous-menu mobile (bouton chevron) et parent sans lien
  nav.querySelectorAll('.dropdown-toggle, .nav-parent-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.nav-item')!.classList.toggle('open');
    });
  });

  // Sur mobile, le lien parent du dropdown toggle l'accordéon (pas de navigation)
  nav.querySelectorAll('.has-dropdown > a').forEach(link => {
    link.addEventListener('click', (e) => {
      if (window.innerWidth <= 768) {
        e.preventDefault();
        link.closest('.nav-item')!.classList.toggle('open');
      }
    });
  });

  // Ferme le menu mobile quand on clique un lien dans le dropdown
  nav.querySelectorAll('.dropdown a').forEach(link => {
    link.addEventListener('click', () => {
      burger.classList.remove('active');
      nav.classList.remove('open');
    });
  });

  // Ferme les dropdowns desktop au clic en dehors
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav-item')) {
      nav.querySelectorAll('.nav-item.open').forEach(item => item.classList.remove('open'));
    }
  });

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
</script>

</body>
</html>
