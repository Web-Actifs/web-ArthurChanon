---
import Layout from '../layouts/Layout.astro';
import arthurImg from '../pics/Arthur.jpg';
---

<Layout title="Contact" description="Contacter Arthur Reynaud-Chanon pour des cours de clarinette à Bruxelles ou en France — email, téléphone, plateformes Apprentus et Superprof.">

  <section class="page-hero">
    <div class="container page-hero-content">
      <span class="hero-label">Échangeons</span>
      <h1>Contact</h1>
      <p>Cours particuliers, prestation événementielle ou simple question — je réponds avec plaisir.</p>
    </div>
  </section>

  <!-- Coordonnées -->
  <section class="section">
    <div class="container">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; max-width:900px; margin:0 auto;" class="reveal">

        <div style="border-radius:12px; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,0.12); aspect-ratio:3/4;">
          <img
            src={arthurImg.src}
            alt="Arthur Reynaud-Chanon"
            loading="lazy"
            style="width:100%; height:100%; object-fit:cover; object-position:center 15%; transform:scale(1.06);"
          >
        </div>

        <div>
          <h3 style="color:var(--navy); font-family:'Playfair Display',serif; font-size:1.6rem; margin-bottom:8px;">Arthur Reynaud-Chanon</h3>
          <p style="color:var(--text-muted); font-weight:300; margin-bottom:32px;">Professeur de clarinette & formation musicale</p>

          <div style="display:flex; flex-direction:column; gap:20px;">

            <div style="display:flex; align-items:center; gap:16px;">
              <div style="background:rgba(201,168,76,0.1); width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--gold);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); margin-bottom:2px;">E-mail</div>
                <a href="mailto:arthur.reynaudchanon@gmail.com" style="font-size:0.98rem; color:var(--navy); text-decoration:none; border-bottom:1px solid rgba(201,168,76,0.4);">arthur.reynaudchanon@gmail.com</a>
              </div>
            </div>

            <div style="display:flex; align-items:center; gap:16px;">
              <div style="background:rgba(201,168,76,0.1); width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--gold);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              </div>
              <div>
                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); margin-bottom:2px;">Téléphone</div>
                <div style="font-size:0.98rem; color:var(--navy);">+33 6 33 18 45 84</div>
                <div style="font-size:0.98rem; color:var(--navy);">+32 473 44 71 86</div>
              </div>
            </div>

            <div style="display:flex; align-items:center; gap:16px;">
              <div style="background:rgba(201,168,76,0.1); width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--gold);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
              </div>
              <div>
                <div style="font-size:0.75rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--text-muted); margin-bottom:2px;">Langues</div>
                <div style="font-size:0.98rem; color:var(--navy);">Français, English, Polski, Español</div>
              </div>
            </div>

          </div>

          <div style="margin-top:32px; padding:20px 24px; background:rgba(201,168,76,0.06); border:1px solid rgba(201,168,76,0.2); border-radius:8px;">
            <p style="font-size:0.88rem; color:#4a4a5a; margin:0; font-style:italic; font-family:'Playfair Display',serif; line-height:1.7;">
              « Premier cours sans engagement — l'occasion de faire connaissance et de parler de votre projet musical. »
            </p>
            <p style="font-family:'Playfair Display',serif; font-style:italic; font-size:1rem; color:var(--gold-dark); letter-spacing:1px; margin:12px 0 0;">A R-C</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <h2>Questions fréquentes</h2>
        <div class="divider"></div>
      </div>

      <div style="max-width:700px; margin:0 auto;" class="reveal">
        <div style="display:flex; flex-direction:column; gap:24px;">

          <div style="border-left:4px solid var(--gold); padding-left:24px;">
            <h4 style="color:var(--navy); margin:0 0 10px; font-size:1rem;">À quel âge commencer la clarinette ?</h4>
            <p style="color:#4a4a5a; font-size:0.92rem; margin:0; line-height:1.6;">À partir de 7 ans environ, lorsque l'enfant a la maturité nécessaire. Mais aussi pour les adultes qui réalisent un rêve musical — je m'adapte à tous les profils et à tous les âges.</p>
          </div>

          <div style="border-left:4px solid var(--gold); padding-left:24px;">
            <h4 style="color:var(--navy); margin:0 0 10px; font-size:1rem;">Où se déroulent les cours ?</h4>
            <p style="color:#4a4a5a; font-size:0.92rem; margin:0; line-height:1.6;">Je propose des cours en présentiel à Bruxelles, Belgique et en France, ainsi que des cours à distance dans toutes les langues (Français, English, Polski, Español).</p>
          </div>

          <div style="border-left:4px solid var(--gold); padding-left:24px;">
            <h4 style="color:var(--navy); margin:0 0 10px; font-size:1rem;">Y a-t-il un premier cours d'essai ?</h4>
            <p style="color:#4a4a5a; font-size:0.92rem; margin:0; line-height:1.6;">Oui, le premier cours est sans engagement — c'est l'occasion de faire connaissance et de parler ensemble de votre projet musical.</p>
          </div>

          <div style="border-left:4px solid var(--gold); padding-left:24px;">
            <h4 style="color:var(--navy); margin:0 0 10px; font-size:1rem;">Faut-il avoir son propre instrument ?</h4>
            <p style="color:#4a4a5a; font-size:0.92rem; margin:0; line-height:1.6;">Pas pour débuter. Je peux vous conseiller sur l'acquisition d'un instrument adapté à votre progression. Pour les cours avancés, un instrument personnel est recommandé.</p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Formulaire de contact -->
  <section class="section section-alt">
    <div class="container" style="max-width:600px;">
      <div class="section-header reveal">
        <h2>Envoyez-moi un message</h2>
        <p>Une demande spécifique ? Remplissez le formulaire ci-dessous.</p>
        <div class="divider"></div>
      </div>

      <form action="https://formspree.io/f/xyzpqwkj" method="POST" style="display:flex; flex-direction:column; gap:20px;" class="reveal">

        <div>
          <label for="name" style="display:block; font-size:0.85rem; font-weight:600; color:var(--navy); margin-bottom:8px;">Votre nom</label>
          <input type="text" id="name" name="name" required style="width:100%; padding:12px 16px; border:1px solid var(--ivory-dark); border-radius:6px; font-size:0.95rem; font-family:inherit; box-sizing:border-box;">
        </div>

        <div>
          <label for="email" style="display:block; font-size:0.85rem; font-weight:600; color:var(--navy); margin-bottom:8px;">Votre email</label>
          <input type="email" id="email" name="email" required style="width:100%; padding:12px 16px; border:1px solid var(--ivory-dark); border-radius:6px; font-size:0.95rem; font-family:inherit; box-sizing:border-box;">
        </div>

        <div>
          <label for="subject" style="display:block; font-size:0.85rem; font-weight:600; color:var(--navy); margin-bottom:8px;">Sujet</label>
          <select id="subject" name="subject" required style="width:100%; padding:12px 16px; border:1px solid var(--ivory-dark); border-radius:6px; font-size:0.95rem; font-family:inherit; box-sizing:border-box; background:var(--white);">
            <option value="">Choisir un sujet...</option>
            <option value="Cours particuliers">Cours particuliers</option>
            <option value="Prestation événementielle">Prestation événementielle</option>
            <option value="Question générale">Question générale</option>
            <option value="Autre">Autre</option>
          </select>
        </div>

        <div>
          <label for="message" style="display:block; font-size:0.85rem; font-weight:600; color:var(--navy); margin-bottom:8px;">Message</label>
          <textarea id="message" name="message" rows="5" required style="width:100%; padding:12px 16px; border:1px solid var(--ivory-dark); border-radius:6px; font-size:0.95rem; font-family:inherit; box-sizing:border-box; resize:vertical;"></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;">Envoyer</button>
      </form>
    </div>
  </section>

  <!-- Plateformes -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="hero-label" style="color:var(--gold-dark)">Réserver en ligne</span>
        <h2>Retrouvez-moi sur les plateformes</h2>
        <p>Consultez mes disponibilités et réservez directement depuis ces services.</p>
        <div class="divider"></div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px; max-width:800px; margin:0 auto;" class="reveal">

        <div style="background:var(--white); border:1px solid rgba(201,168,76,0.2); border-radius:12px; padding:36px 32px; display:flex; flex-direction:column; gap:20px; box-shadow:0 4px 16px rgba(0,0,0,0.06);">
          <div>
            <div style="font-size:0.7rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--gold-dark); margin-bottom:8px;">Belgique</div>
            <h3 style="font-family:'Playfair Display',serif; font-size:1.4rem; color:var(--navy); margin:0 0 12px;">Apprentus</h3>
            <p style="color:var(--text-muted); font-size:0.92rem; line-height:1.6; margin:0;">Plateforme de mise en relation entre professeurs et élèves — avis vérifiés, profil complet et réservation en ligne.</p>
          </div>
          <a
            href="https://www.apprentus.be/cours-particuliers/bruxelles/musique/clarinette/apprendre-clarinette-solfege-a-domicile?from_landing_page=true"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="align-self:flex-start;"
          >
            Voir mon profil
          </a>
        </div>

        <div style="background:var(--white); border:1px solid rgba(201,168,76,0.2); border-radius:12px; padding:36px 32px; display:flex; flex-direction:column; gap:20px; box-shadow:0 4px 16px rgba(0,0,0,0.06);">
          <div>
            <div style="font-size:0.7rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--gold-dark); margin-bottom:8px;">France & International</div>
            <h3 style="font-family:'Playfair Display',serif; font-size:1.4rem; color:var(--navy); margin:0 0 12px;">Superprof</h3>
            <p style="color:var(--text-muted); font-size:0.92rem; line-height:1.6; margin:0;">Le réseau de professeurs particuliers — trouvez mes créneaux disponibles et consultez les avis de mes élèves.</p>
          </div>
          <a
            href="https://www.superprof.be/clarinettiste-professeur-clarinette-formation-musicale-diplome-deux-domaines-donne-cours-clarinette.html"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="align-self:flex-start;"
          >
            Voir mon profil
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>
